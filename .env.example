# Copy to .env for optional settings. Never commit .env.
# SQLite is the default local demo. No MySQL credentials are needed for SQLite.
DATABASE_TYPE=sqlite
SQLITE_PATH=database/password-manager.sqlite
MYSQL_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=password_manager
MYSQL_SSL=false
# Hosted MySQL normally requires MYSQL_SSL=true. Optional provider CA certificate:
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
PORT=3000
# Open Google Chrome after local startup. Set false to open the browser yourself.
OPEN_BROWSER=true
# Local development binding. Netlify uses the Function instead of this server.
HOST=127.0.0.1
